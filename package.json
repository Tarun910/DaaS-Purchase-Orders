{
  "name": "daas-take-home",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build:api": "npm run build -w api",
    "build:web": "npm run build -w web",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "db:generate": "npm run db:generate -w api"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "embedded-postgres@18.4.0-beta.17": true,
    "@apollo/protobufjs@1.2.8": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
